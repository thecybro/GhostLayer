{
  "manifest_version": 3,
  "name": "GhostLayer",
  "version": "0.1.0",
  "description": "End to end encrypt messages in any web chat. Your keys never leave your device. No accounts, no servers.",
  "homepage_url": "https://github.com/thecybro/GhostLayer",

  "action": {
    "default_popup": "popup.html"
  },

  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"]
    }
  ],
  
  "permissions": [
    "storage",
    "clipboardWrite"
  ],

  "icons": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
  },

  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
}